<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for the Developer ID signed ExampleApp.app (scripts/sign-mac-app.sh).
  Notarization requires the hardened runtime, and a JVM cannot run under it without these three:
    allow-jit                        HotSpot's JIT maps its code cache with MAP_JIT.
    allow-unsigned-executable-memory the JVM writes executable stubs and adapters outside MAP_JIT regions.
    disable-library-validation       JavaFX (and JNA, if you add it) unpacks native libraries to a cache
                                     directory and loads them from there, unsigned by our team ID.
  Add nothing else unless the app needs it: every exception is one Apple's notary review can question.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
