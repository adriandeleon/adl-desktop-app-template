{
  "template": true,
  "exceptions": [
    {
      "rule": "CLI-10",
      "level": "SHOULD",
      "url": "https://pauta-project.dev/6.0.0/command-line/#cli-10",
      "kind": "pending",
      "reason": "Tools such as git are looked for in a fixed list of folders instead of your login shell's path.",
      "link": "https://github.com/adriandeleon/adl-desktop-app-template/issues/16"
    },
    {
      "rule": "DIAG-07",
      "level": "SHOULD",
      "url": "https://pauta-project.dev/6.0.0/diagnostics/#diag-07",
      "kind": "pending",
      "reason": "There is no page that checks the outside tools the app uses, such as git and gh.",
      "link": "https://github.com/adriandeleon/adl-desktop-app-template/issues/16"
    },
    {
      "rule": "ICON-14",
      "level": "SHOULD",
      "url": "https://pauta-project.dev/6.0.0/icons-and-color/#icon-14",
      "kind": "pending",
      "reason": "The key color's contrast is checked by a test that needs the toolkit instead of a plain one.",
      "link": "https://github.com/adriandeleon/adl-desktop-app-template/issues/19"
    },
    {
      "rule": "PERF-17",
      "level": "SHOULD",
      "url": "https://pauta-project.dev/6.0.0/performance/#perf-17",
      "kind": "pending",
      "reason": "The stylesheets are not converted to their faster binary form for release builds.",
      "link": "https://github.com/adriandeleon/adl-desktop-app-template/issues/18"
    },
    {
      "rule": "PERF-19",
      "level": "SHOULD",
      "url": "https://pauta-project.dev/6.0.0/performance/#perf-19",
      "kind": "pending",
      "reason": "There is no script that measures how long the app takes to start.",
      "link": "https://github.com/adriandeleon/adl-desktop-app-template/issues/18"
    },
    {
      "rule": "PERF-20",
      "level": "SHOULD",
      "url": "https://pauta-project.dev/6.0.0/performance/#perf-20",
      "kind": "pending",
      "reason": "There is no switch that records what keeps the window busy.",
      "link": "https://github.com/adriandeleon/adl-desktop-app-template/issues/18"
    },
    {
      "rule": "QUAL-13",
      "level": "SHOULD",
      "url": "https://pauta-project.dev/6.0.0/quality/#qual-13",
      "kind": "pending",
      "reason": "No test sets every control in Settings and reads them back after a restart.",
      "link": "https://github.com/adriandeleon/adl-desktop-app-template/issues/19"
    },
    {
      "rule": "REL-17",
      "level": "SHOULD",
      "url": "https://pauta-project.dev/6.0.0/release/#rel-17",
      "kind": "pending",
      "reason": "The Windows installer is not signed yet, though the release could sign it from a certificate each app supplies, as it signs the other systems' builds.",
      "link": "https://github.com/adriandeleon/adl-desktop-app-template/issues/14"
    },
    {
      "rule": "SET-18",
      "level": "SHOULD",
      "url": "https://pauta-project.dev/6.0.0/settings/#set-18",
      "kind": "pending",
      "reason": "Settings Sync does not remember which GitHub account each copy uses.",
      "link": "https://github.com/adriandeleon/adl-desktop-app-template/issues/15"
    },
    {
      "rule": "SET-20",
      "level": "SHOULD",
      "url": "https://pauta-project.dev/6.0.0/settings/#set-20",
      "kind": "pending",
      "reason": "Settings Sync replaces your key bindings without keeping a copy of the old ones first.",
      "link": "https://github.com/adriandeleon/adl-desktop-app-template/issues/15"
    },
    {
      "rule": "DOCS-01",
      "level": "MUST",
      "url": "https://pauta-project.dev/6.0.0/documentation/#docs-01",
      "kind": "app-only",
      "reason": "The user guide lives on each app's own website, which a template does not have."
    },
    {
      "rule": "DOCS-02",
      "level": "MUST",
      "url": "https://pauta-project.dev/6.0.0/documentation/#docs-02",
      "kind": "app-only",
      "reason": "The user guide's pages under /docs/ belong to each app's own website."
    },
    {
      "rule": "PAUTA-13",
      "level": "MUST",
      "url": "https://pauta-project.dev/6.0.0/conformance/#pauta-13",
      "kind": "app-only",
      "reason": "Each app's user guide has its own page listing its conformance and exceptions."
    },
    {
      "rule": "REL-19",
      "level": "MUST",
      "url": "https://pauta-project.dev/6.0.0/release/#rel-19",
      "kind": "app-only",
      "reason": "Each app's repository requires its own format and test checks before a change is merged."
    },
    {
      "rule": "REPO-01",
      "level": "MUST",
      "url": "https://pauta-project.dev/6.0.0/repository/#repo-01",
      "kind": "app-only",
      "reason": "Each app's README shows its own screenshots; the template's are placeholders."
    },
    {
      "rule": "DOCS-03",
      "level": "SHOULD",
      "url": "https://pauta-project.dev/6.0.0/documentation/#docs-03",
      "kind": "app-only",
      "reason": "Each app's website serves its own user guide for each version."
    },
    {
      "rule": "DOCS-04",
      "level": "SHOULD",
      "url": "https://pauta-project.dev/6.0.0/documentation/#docs-04",
      "kind": "app-only",
      "reason": "Each app's website makes its own command and settings pages and What's new from the app."
    },
    {
      "rule": "DOCS-18",
      "level": "SHOULD",
      "url": "https://pauta-project.dev/6.0.0/documentation/#docs-18",
      "kind": "app-only",
      "reason": "Each app captures its own screenshots from itself; the template's are placeholders."
    },
    {
      "rule": "PAUTA-14",
      "level": "SHOULD",
      "url": "https://pauta-project.dev/6.0.0/conformance/#pauta-14",
      "kind": "app-only",
      "reason": "Each app's website makes its conformance page from the app's own list of exceptions."
    }
  ]
}
